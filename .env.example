# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Twilio ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
MY_PHONE_NUMBER=+1...

# --- Strava ---
# Client ID/Secret come from strava.com/settings/api.
# Access/refresh tokens come from running `uv run python scripts/strava_oauth.py` once.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Deployment ---
# Public base URL of this service (e.g. https://goggins-agent-production.up.railway.app).
# Twilio uses this to fetch audio files and TwiML during outbound calls.
PUBLIC_BASE_URL=
